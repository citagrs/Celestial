---
/**
 * Logotipo original: dos manos que sostienen un corazón con una cruz de salud.
 * Usa las variables de color de la marca, así se recolorea con cada cliente.
 */
interface Props {
  size?: number;
  class?: string;
  title?: string;
  /** Activa el latido suave del corazón. */
  beat?: boolean;
}
const { size = 44, class: className = '', title, beat = false } = Astro.props;
---
<svg
  class:list={['logo', className, { 'logo--beat': beat }]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  <g class="logo-heart">
    <path
      d="M32 44.5C20.5 37.4 14 30.6 14 23.4 14 18.2 17.9 14.5 22.6 14.5c3.8 0 6.9 2.2 9.4 5.6 2.5-3.4 5.6-5.6 9.4-5.6 4.7 0 8.6 3.7 8.6 8.9 0 7.2-6.5 14-18 21.1z"
      fill="var(--c-primary)"
    />
    <path d="M29.6 20.5h4.8v5h5v4.8h-5v5h-4.8v-5h-5v-4.8h5z" fill="#fff" />
  </g>
  <g fill="none" stroke="var(--c-deep)" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 31.5c-.6 5 1.3 9.6 5.5 13.3 5.3 4.6 12.2 7 19.3 7.4" />
    <path d="M6 31.5c1.5-1.7 3.9-1.4 4.9.6l3.2 6.4" />
    <path d="M58 31.5c.6 5-1.3 9.6-5.5 13.3-5.3 4.6-12.2 7-19.3 7.4" />
    <path d="M58 31.5c-1.5-1.7-3.9-1.4-4.9.6l-3.2 6.4" />
  </g>
  <path class="logo-spark" d="M51 6l1.3 3.7L56 11l-3.7 1.3L51 16l-1.3-3.7L46 11l3.7-1.3z" fill="var(--c-accent)" />
</svg>

<style>
  .logo { flex-shrink: 0; overflow: visible; }
  .logo-heart, .logo-spark { transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .logo--beat .logo-heart { animation: logo-beat 0.833s ease-out infinite; }
    .logo--beat .logo-spark { animation: logo-twinkle 3.2s ease-in-out infinite; }
  }
  @keyframes logo-beat {
    0%, 45%, 100% { transform: scale(1); }
    12% { transform: scale(1.08); }
    24% { transform: scale(0.99); }
    33% { transform: scale(1.05); }
  }
  @keyframes logo-twinkle {
    0%, 100% { transform: scale(1) rotate(0); opacity: 1; }
    50% { transform: scale(0.6) rotate(45deg); opacity: 0.6; }
  }
</style>
