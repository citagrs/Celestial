---
import { site } from '../config/site';

/** Contadores animados. Solo se muestran si `stats` tiene cifras reales en site.ts. */
const { stats } = site;
---
{stats.length > 0 && (
  <section class="py-14" aria-label="Cifras">
    <ul class="container-x grid grid-cols-2 gap-8 text-center md:grid-cols-4">
      {stats.map((s) => (
        <li data-reveal>
          <p class="font-display text-4xl font-extrabold text-primary-ink tabular-nums md:text-5xl">
            <span data-count={s.value}>{s.value}</span>{s.suffix}
          </p>
          <p class="mt-2 text-muted">{s.label}</p>
        </li>
      ))}
    </ul>
  </section>
)}
