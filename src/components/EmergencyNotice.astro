---
import { site } from '../config/site';

const { emergencyNote, emergencyPhone } = site.legal;
---
<aside class="container-x" aria-label="Información de urgencias">
  <div class="emergency" data-reveal>
    <span class="emergency-icon" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3 2.5 20h19L12 3z" /><path d="M12 10v4.5M12 17.5h.01" />
      </svg>
    </span>
    <div class="flex-1">
      <p class="font-display text-lg font-extrabold">¿Es una urgencia?</p>
      <p class="mt-1">{emergencyNote} WhatsApp no es un canal para atender urgencias.</p>
    </div>
    <a href={`tel:${emergencyPhone}`} class="btn emergency-btn">
      Llamar al {emergencyPhone}
    </a>
  </div>
</aside>

<style>
  .emergency {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: 1.5rem;
    background: #fff7f5;
    border: 2px solid #f1c9bf;
    color: #5b1f12;
  }
  @media (min-width: 768px) {
    .emergency { flex-direction: row; align-items: center; gap: 1.5rem; padding: 1.5rem 2rem; }
  }
  .emergency-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: #fde3dc;
    color: #a3341c;
  }
  .emergency-btn { background: #a3341c; color: #fff; white-space: nowrap; }
</style>
