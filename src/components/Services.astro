---
import { site } from '../config/site';
import SectionHeading from './SectionHeading.astro';
import ServiceCard from './ServiceCard.astro';
import ComplianceNote from './ComplianceNote.astro';

const { services } = site;
---
<section id="servicios" class="section" aria-labelledby="services-title">
  <div class="container-x">
    <SectionHeading id="services-title" eyebrow={services.eyebrow} title={services.title} subtitle={services.subtitle} />
    <div class="mt-12 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {services.items.map((s, i) => <ServiceCard service={s} index={i} />)}
    </div>
    <ComplianceNote class="mt-10 text-center" />
  </div>
</section>
