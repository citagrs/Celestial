---
import { site } from '../config/site';
import { waLink } from '../lib/whatsapp';
import WhatsAppIcon from './WhatsAppIcon.astro';

/** Botón flotante con pulso suave. El tooltip aparece a los 6 s (solo CSS, sin JS). */
const { whatsapp } = site;
---
<a
  class="wa-float"
  href={waLink()}
  target="_blank"
  rel="noopener"
  data-wa="flotante"
  aria-label={`Escríbenos por WhatsApp al ${whatsapp.display} (se abre en una pestaña nueva)`}
>
  <span class="wa-tip" aria-hidden="true">{whatsapp.floatTooltip}</span>
  <span class="wa-pulse" aria-hidden="true"></span>
  <WhatsAppIcon size={30} />
</a>

<style>
  .wa-float {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 45;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: var(--c-primary-ink);
    color: #fff;
    box-shadow: 0 14px 30px -10px rgb(var(--c-deep-rgb) / 0.6);
    transition: transform 0.3s cubic-bezier(.3,1.6,.5,1);
  }
  @media (min-width: 768px) { .wa-float { right: 1.5rem; bottom: 1.5rem; width: 4rem; height: 4rem; } }
  .wa-float:hover { transform: scale(1.08); }
  .wa-float :global(svg) { position: relative; }
  .wa-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--c-primary);
    opacity: 0;
  }
  .wa-tip {
    position: absolute;
    right: calc(100% + 0.75rem);
    top: 50%;
    padding: 0.55rem 0.95rem;
    border-radius: 1rem 1rem 0.25rem 1rem;
    background: #fff;
    color: var(--c-deep);
    font-family: var(--font-display);
    font-weight: 800;
    white-space: nowrap;
    box-shadow: 0 10px 30px -12px rgb(var(--c-deep-rgb) / 0.55);
    opacity: 0;
    transform: translate(8px, -50%);
    pointer-events: none;
    transition: opacity 0.3s, transform 0.3s;
  }
  .wa-float:hover .wa-tip,
  .wa-float:focus-visible .wa-tip { opacity: 1; transform: translate(0, -50%); }

  @media (prefers-reduced-motion: no-preference) {
    .wa-pulse { animation: wa-pulse 2.8s ease-out 2s infinite; }
    .wa-tip { animation: wa-tip 9s ease 6s both; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-tip { opacity: 1; transform: translate(0, -50%); }
  }
  @keyframes wa-pulse {
    0% { opacity: 0.55; transform: scale(1); }
    70%, 100% { opacity: 0; transform: scale(1.6); }
  }
  @keyframes wa-tip {
    0% { opacity: 0; transform: translate(8px, -50%) scale(0.9); }
    6%, 90% { opacity: 1; transform: translate(0, -50%) scale(1); }
    100% { opacity: 0; transform: translate(8px, -50%) scale(0.9); }
  }
</style>
