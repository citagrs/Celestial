---
import { site } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';
import Logo from './Logo.astro';

const { finalCta, whatsapp } = site;
---
<section class="final" aria-labelledby="final-title" data-animate>
  <div class="final-glow" aria-hidden="true"></div>
  <div class="container-x relative text-center">
    <div class="final-logo mx-auto" data-reveal="scale">
      <span class="final-ring" aria-hidden="true"></span>
      <span class="final-ring r2" aria-hidden="true"></span>
      <Logo size={84} beat />
    </div>
    <h2 id="final-title" class="mx-auto mt-8 max-w-3xl text-[clamp(2rem,1.3rem+3vw,3.25rem)] font-extrabold text-white" data-reveal style="--i:1">
      {finalCta.title}
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-white/85" data-reveal style="--i:2">{finalCta.text}</p>
    <div class="mt-9" data-reveal style="--i:3">
      <WhatsAppButton variant="light" source="cta-final" label={finalCta.cta} message={whatsapp.generalMessage} class="!px-7 !py-4 text-lg" />
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: 5.5rem;
    background: linear-gradient(160deg, var(--c-primary-ink) 0%, var(--c-deep) 75%);
  }
  @media (min-width: 768px) { .final { padding-block: 7rem; } }
  .final-glow {
    position: absolute;
    inset: -30% -10% auto;
    height: 120%;
    z-index: -1;
    background:
      radial-gradient(circle at 20% 30%, rgb(var(--c-accent-rgb) / 0.22), transparent 40%),
      radial-gradient(circle at 80% 60%, rgb(255 255 255 / 0.12), transparent 45%);
  }
  .final-logo {
    position: relative;
    display: grid;
    place-items: center;
    width: 8.5rem;
    height: 8.5rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.5);
  }
  .final-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid rgb(255 255 255 / 0.6);
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .final-ring { animation: final-ring 2.5s cubic-bezier(.1,.6,.3,1) infinite; }
    .final-ring.r2 { animation-delay: 1.25s; }
  }
  @keyframes final-ring {
    0% { opacity: 0.8; transform: scale(1); }
    80%, 100% { opacity: 0; transform: scale(1.7); }
  }
</style>
