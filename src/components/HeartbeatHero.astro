---
import { site } from '../config/site';
import WhatsAppButton from './WhatsAppButton.astro';

/**
 * Hero con corazón que late a 72 lpm (doble pulso "lub-dub"),
 * ondas concéntricas, electrocardiograma sincronizado, blobs y destellos.
 * Sincronía: ciclo cardiaco = 60/72 s = 0,833 s. El ECG dibuja 3 latidos en 2,5 s.
 */
const { hero, coverage, whatsapp } = site;

// Trazo del ECG generado: complejos P-QRS-T con el pico R en x = 150, 650 y 1150.
const BASE = 62;
const complex = (r: number) =>
  [
    `L${r - 95} ${BASE}`,
    `Q${r - 78} ${BASE - 12} ${r - 61} ${BASE}`, // onda P
    `L${r - 14} ${BASE}`,
    `L${r - 8} ${BASE + 7}`, // Q
    `L${r} ${BASE - 54}`, // R
    `L${r + 9} ${BASE + 20}`, // S
    `L${r + 17} ${BASE}`,
    `L${r + 55} ${BASE}`,
    `Q${r + 85} ${BASE - 20} ${r + 115} ${BASE}`, // onda T
  ].join(' ');
const ecgPath = `M0 ${BASE} ${[150, 650, 1150].map(complex).join(' ')} L1200 ${BASE}`;

const heartPath =
  'M32 44.5C20.5 37.4 14 30.6 14 23.4 14 18.2 17.9 14.5 22.6 14.5c3.8 0 6.9 2.2 9.4 5.6 2.5-3.4 5.6-5.6 9.4-5.6 4.7 0 8.6 3.7 8.6 8.9 0 7.2-6.5 14-18 21.1z';
---
<section id="inicio" class="hero" data-animate data-hero aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true">
    <svg class="blob blob-1" viewBox="0 0 200 200" width="560" height="560">
      <defs>
        <radialGradient id="blobA" cx="50%" cy="45%" r="60%">
          <stop offset="0" stop-color="var(--c-primary)" stop-opacity="0.32" />
          <stop offset="1" stop-color="var(--c-primary)" stop-opacity="0" />
        </radialGradient>
      </defs>
      <path class="blob-a" fill="url(#blobA)" transform="translate(100 100)" d="M44.7-62.3C57.1-52.4 65.5-37.6 70.2-21.7 74.9-5.8 75.9 11.2 69.8 25.2 63.7 39.2 50.5 50.2 35.8 58.9 21.1 67.6 4.9 74-11.9 73.1-28.7 72.2-46.1 64-57.4 50.8-68.7 37.6-73.9 19.3-73.3 1.4-72.7-16.5-66.3-34-54.6-44.2-42.9-54.4-25.9-57.3-9.9-61.1 6.1-64.9 32.3-72.2 44.7-62.3z" />
      <path class="blob-b" fill="url(#blobA)" transform="translate(100 100)" d="M38.5-51.9C50.9-44.4 62.4-34 67.5-20.6 72.6-7.2 71.3 9.2 64.6 22.5 57.9 35.8 45.8 46 32.4 54.4 19 62.8 4.3 69.4-11.9 70.7-28.1 72-45.8 68-56.3 56.9-66.8 45.8-70.1 27.6-71.2 10.1-72.3-7.4-71.2-24.2-62.5-35.7-53.8-47.2-37.5-53.4-22.6-60.1-7.7-66.8 5.8-74 18.4-71.4 31-68.8 26.1-59.4 38.5-51.9z" />
    </svg>
    <svg class="blob blob-2" viewBox="0 0 200 200" width="420" height="420">
      <defs>
        <radialGradient id="blobB" cx="50%" cy="50%" r="60%">
          <stop offset="0" stop-color="var(--c-accent)" stop-opacity="0.26" />
          <stop offset="1" stop-color="var(--c-accent)" stop-opacity="0" />
        </radialGradient>
      </defs>
      <path class="blob-a" fill="url(#blobB)" transform="translate(100 100)" d="M38.5-51.9C50.9-44.4 62.4-34 67.5-20.6 72.6-7.2 71.3 9.2 64.6 22.5 57.9 35.8 45.8 46 32.4 54.4 19 62.8 4.3 69.4-11.9 70.7-28.1 72-45.8 68-56.3 56.9-66.8 45.8-70.1 27.6-71.2 10.1-72.3-7.4-71.2-24.2-62.5-35.7-53.8-47.2-37.5-53.4-22.6-60.1-7.7-66.8 5.8-74 18.4-71.4 31-68.8 26.1-59.4 38.5-51.9z" />
    </svg>
    <svg class="blob blob-3" viewBox="0 0 200 200" width="480" height="480">
      <path class="blob-a" fill="url(#blobA)" transform="translate(100 100)" d="M44.7-62.3C57.1-52.4 65.5-37.6 70.2-21.7 74.9-5.8 75.9 11.2 69.8 25.2 63.7 39.2 50.5 50.2 35.8 58.9 21.1 67.6 4.9 74-11.9 73.1-28.7 72.2-46.1 64-57.4 50.8-68.7 37.6-73.9 19.3-73.3 1.4-72.7-16.5-66.3-34-54.6-44.2-42.9-54.4-25.9-57.3-9.9-61.1 6.1-64.9 32.3-72.2 44.7-62.3z" />
    </svg>
    <canvas class="sparkles" data-sparkles></canvas>
  </div>

  <div class="container-x hero-grid">
    <div class="hero-visual" aria-hidden="true">
      <svg class="heart-svg" viewBox="-12 -14 88 88" width="420" height="420">
        <defs>
          <linearGradient id="heartFill" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="var(--c-primary)" />
            <stop offset="1" stop-color="var(--c-deep)" />
          </linearGradient>
          <radialGradient id="heartGlow">
            <stop offset="0" stop-color="var(--c-primary)" stop-opacity="0.35" />
            <stop offset="1" stop-color="var(--c-primary)" stop-opacity="0" />
          </radialGradient>
        </defs>
        <circle class="glow" cx="32" cy="30" r="34" fill="url(#heartGlow)" />
        <circle class="ring ring-1" cx="32" cy="29" r="17" />
        <circle class="ring ring-2" cx="32" cy="29" r="17" />
        <circle class="ring ring-3" cx="32" cy="29" r="17" />
        <g class="beat">
          <path d={heartPath} fill="url(#heartFill)" />
          <path d="M29.6 20.5h4.8v5h5v4.8h-5v5h-4.8v-5h-5v-4.8h5z" fill="#fff" />
          <path d="M20 21.5c.8-2.4 2.6-3.7 4.6-3.9" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width="1.4" stroke-linecap="round" />
        </g>
        <g fill="none" stroke="var(--c-deep)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 31.5c-.6 5 1.3 9.6 5.5 13.3 5.3 4.6 12.2 7 19.3 7.4" />
          <path d="M6 31.5c1.5-1.7 3.9-1.4 4.9.6l3.2 6.4" />
          <path d="M58 31.5c.6 5-1.3 9.6-5.5 13.3-5.3 4.6-12.2 7-19.3 7.4" />
          <path d="M58 31.5c-1.5-1.7-3.9-1.4-4.9.6l-3.2 6.4" />
        </g>
        <g fill="var(--c-accent)">
          <path class="twinkle t1" d="M55 2l1 3 3 1-3 1-1 3-1-3-3-1 3-1z" />
          <path class="twinkle t2" d="M6 6l.8 2.2L9 9l-2.2.8L6 12l-.8-2.2L3 9l2.2-.8z" />
          <path class="twinkle t3" d="M62 44l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z" />
        </g>
      </svg>
    </div>

    <div class="hero-copy">
      <p class="eyebrow" data-reveal style="--i:0">{hero.eyebrow}</p>
      <h1 id="hero-title" class="hero-title">{hero.title}</h1>
      <p class="lead mt-5 max-w-xl">{hero.subtitle}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal style="--i:2">
        <WhatsAppButton source="hero" label={hero.primaryCta} message={whatsapp.generalMessage} />
        <a href="#servicios" class="btn btn-ghost">
          {hero.secondaryCta}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
        </a>
      </div>

      <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-deep/80" data-reveal style="--i:3">
        {hero.reassurance.map((r) => (
          <li class="flex items-center gap-1.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--c-primary-ink)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
            {r}
          </li>
        ))}
      </ul>
      <p class="mt-4 flex items-start gap-1.5 text-sm text-muted" data-reveal style="--i:4">
        <svg class="mt-0.5 shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--c-accent-ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
        {coverage.summary}
      </p>
    </div>
  </div>

  <div class="ecg" aria-hidden="true">
    <svg viewBox="0 0 1200 100" preserveAspectRatio="none" width="1200" height="100">
      <path class="ecg-base" d={`M0 ${BASE} H1200`} />
      <path class="ecg-line" d={ecgPath} pathLength="1" />
    </svg>
  </div>

  <svg class="hero-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" width="1440" height="80" aria-hidden="true">
    <path d="M0 48C240 88 480 88 720 56s480-72 720-32v56H0z" fill="var(--c-soft)" />
  </svg>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: 1.5rem;
    padding-bottom: 7rem;
    background: linear-gradient(180deg, var(--c-primary-tint) 0%, var(--c-white) 70%);
  }
  .hero-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .blob {
    position: absolute;
    width: auto;
    height: auto;
    translate: var(--px, 0) var(--py, 0);
    transition: translate 1.2s cubic-bezier(.2,.7,.2,1);
  }
  .blob-1 { width: 34rem; top: -10rem; right: -12rem; }
  .blob-2 { width: 24rem; bottom: 0; left: -9rem; }
  .blob-3 { width: 26rem; top: 30%; left: 35%; opacity: 0.6; }
  .blob path { transform-box: fill-box; transform-origin: center; }
  .sparkles { position: absolute; inset: 0; width: 100%; height: 100%; }

  .hero-grid {
    display: grid;
    align-items: center;
    gap: 0.5rem;
  }
  .hero-visual { display: flex; justify-content: center; }
  .heart-svg { width: 9.5rem; height: auto; overflow: visible; }
  @media (min-width: 400px) and (min-height: 760px) { .heart-svg { width: 11rem; } }
  .hero-title {
    margin-top: 0.85rem;
    font-size: clamp(2.2rem, 1.3rem + 4.2vw, 4rem);
    font-weight: 800;
    color: var(--c-deep);
  }

  @media (min-width: 768px) {
    .hero { padding-top: 3rem; padding-bottom: 9rem; }
    .hero-grid { grid-template-columns: 1.15fr 0.85fr; gap: 3rem; }
    .hero-visual { order: 2; }
    .heart-svg { width: 100%; max-width: 26rem; }
  }

  .ring {
    fill: none;
    stroke: var(--c-primary);
    stroke-width: 0.8;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .beat, .glow, .twinkle { transform-box: fill-box; transform-origin: center; }

  .ecg {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3.25rem;
    height: 4.5rem;
    opacity: 0.85;
  }
  .ecg svg { width: 100%; height: 100%; }
  .ecg path { fill: none; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
  .ecg-base { stroke: rgb(var(--c-primary-rgb) / 0.14); stroke-width: 1.5; }
  .ecg-line { stroke: var(--c-primary); stroke-width: 2.5; stroke-dasharray: 1; stroke-dashoffset: 0; }

  .hero-wave { position: absolute; left: 0; bottom: -1px; width: 100%; height: 3.5rem; }

  @media (prefers-reduced-motion: no-preference) {
    .beat { animation: lubdub 0.833s cubic-bezier(.3,0,.3,1) 0.15s infinite; }
    .glow { animation: glow 0.833s ease-out 0.15s infinite; }
    .ring-1 { animation: ripple 2.5s cubic-bezier(.1,.6,.3,1) 0.15s infinite; }
    .ring-2 { animation: ripple 2.5s cubic-bezier(.1,.6,.3,1) 0.983s infinite; }
    .ring-3 { animation: ripple 2.5s cubic-bezier(.1,.6,.3,1) 1.816s infinite; }
    .ecg-line { animation: ecg 2.5s linear infinite; }
    .twinkle { animation: twinkle 3s ease-in-out infinite; }
    .t2 { animation-delay: -1s; }
    .t3 { animation-delay: -2s; }
    .blob-a { animation: blob-a 26s ease-in-out infinite alternate; }
    .blob-b { animation: blob-b 32s ease-in-out infinite alternate; }
    .blob-2 .blob-a { animation-duration: 22s; animation-direction: alternate-reverse; }
  }

  /* Doble pulso: "lub" (fuerte) y "dub" (suave) */
  @keyframes lubdub {
    0% { transform: scale(1); }
    12% { transform: scale(1.11); }
    22% { transform: scale(0.98); }
    32% { transform: scale(1.06); }
    46%, 100% { transform: scale(1); }
  }
  @keyframes glow {
    0%, 60%, 100% { opacity: 0.55; transform: scale(1); }
    14% { opacity: 1; transform: scale(1.08); }
  }
  @keyframes ripple {
    0% { opacity: 0.7; transform: scale(1); }
    70% { opacity: 0; transform: scale(2.35); }
    100% { opacity: 0; transform: scale(2.35); }
  }
  @keyframes ecg {
    0% { stroke-dashoffset: 1; opacity: 1; }
    80% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes twinkle {
    0%, 100% { opacity: 1; transform: scale(1) rotate(0); }
    50% { opacity: 0.35; transform: scale(0.55) rotate(45deg); }
  }
  @keyframes blob-a {
    0% { transform: translate(0, 0) rotate(0) scale(1); }
    50% { transform: translate(6%, 4%) rotate(40deg) scale(1.08); }
    100% { transform: translate(-4%, 6%) rotate(80deg) scale(0.95); }
  }
  @keyframes blob-b {
    0% { transform: rotate(0) scale(1.05); }
    100% { transform: translate(-6%, -3%) rotate(-70deg) scale(0.92); }
  }
</style>
