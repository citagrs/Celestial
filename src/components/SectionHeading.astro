---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
}
const { id, eyebrow, title, subtitle, align = 'center' } = Astro.props;
---
<div class:list={['max-w-2xl', align === 'center' ? 'mx-auto text-center' : '']}>
  <p class="eyebrow" data-reveal>{eyebrow}</p>
  <h2 id={id} class="h2 mt-3" data-reveal style="--i:1">{title}</h2>
  {subtitle && <p class="lead mt-4" data-reveal style="--i:2">{subtitle}</p>}
</div>
