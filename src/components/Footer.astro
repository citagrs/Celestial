---
import { site } from '../config/site';
import { waLink } from '../lib/whatsapp';
import Logo from './Logo.astro';
import { withBase } from '../lib/url';
import ComplianceNote from './ComplianceNote.astro';

const { brand, whatsapp, contact, coverage, legal, services } = site;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container-x grid gap-10 py-14 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-3">
        <span class="grid h-14 w-14 place-items-center rounded-2xl bg-white"><Logo size={42} /></span>
        <div>
          <p class="font-display text-xl font-extrabold tracking-wide">{brand.name}</p>
          <p class="text-sm text-white/75">{brand.descriptor}</p>
        </div>
      </div>
      <p class="mt-5 max-w-sm font-display text-lg font-bold text-accent">“{brand.slogan}”</p>
      <p class="mt-3 max-w-sm text-sm text-white/75">Fundadora: {site.founder.name}</p>
    </div>

    <div>
      <h2 class="text-base font-bold">Contacto</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-white/85">
        <li>
          WhatsApp:{' '}
          <a class="underline decoration-accent underline-offset-4 hover:text-white" href={waLink()} target="_blank" rel="noopener" data-wa="footer">
            {whatsapp.display}
          </a>
        </li>
        {contact.email && <li>Correo: <a class="underline decoration-accent underline-offset-4" href={`mailto:${contact.email}`}>{contact.email}</a></li>}
        {contact.address && <li>{contact.address}</li>}
        {contact.hours && <li>Horario: {contact.hours}</li>}
        <li>{coverage.detail}</li>
      </ul>
    </div>

    <div>
      <h2 class="text-base font-bold">Servicios</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-white/85">
        {services.items.map((s) => <li><a class="hover:text-white hover:underline" href={withBase('/#servicios')}>{s.title}</a></li>)}
      </ul>
      <h2 class="mt-7 text-base font-bold">Legal</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-white/85">
        <li><a class="underline decoration-accent underline-offset-4 hover:text-white" href={withBase(legal.privacyPolicyPath)}>Política de tratamiento de datos personales</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x space-y-3 py-7 text-[0.8rem] leading-relaxed text-white/75">
      <p class="font-semibold text-white">{legal.emergencyNote}</p>
      <ComplianceNote tone="dark" class="!text-[0.8rem]" />
      <p>{legal.disclaimer}</p>
      <p>© {year} {brand.fullName}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .footer { background: #0f3540; background: color-mix(in srgb, var(--c-deep) 82%, black); color: #fff; padding-bottom: 5rem; }
  @media (min-width: 768px) { .footer { padding-bottom: 0; } }
</style>
