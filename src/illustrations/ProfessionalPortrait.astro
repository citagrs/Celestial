---
/** Retrato ilustrativo de una profesional de la salud (bata, uniforme y fonendoscopio). Recoloreable con --ill-*. */
import './illustrations.css';
interface Props { label: string; class?: string; style?: string }
const { label, class: className = '', style } = Astro.props;
---
<svg class:list={['ill', 'ill-portrait', className]} style={style} viewBox="0 0 240 280" width="240" height="280" role="img" aria-label={label}>
  <path class="twinkle fb" d="M38 52l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" fill="var(--ill-accent)" />
  <path class="twinkle fb" d="M200 70l1.6 4 4 1.6-4 1.6-1.6 4-1.6-4-4-1.6 4-1.6z" fill="var(--ill-accent)" />
  <path class="twinkle fb" d="M206 150l1.3 3.2 3.2 1.3-3.2 1.3-1.3 3.2-1.3-3.2-3.2-1.3 3.2-1.3z" fill="#fff" />

  <!-- Cabello (atrás) -->
  <path d="M78 102C74 50 166 50 162 102l7 92c-18 10-80 10-98 0z" fill="var(--ill-hair-2)" />

  <g class="body vb">
    <rect x="108" y="132" width="24" height="34" rx="8" fill="var(--ill-skin-2)" />
    <path d="M108 150q12 8 24 0v12h-24z" fill="#000" opacity=".12" />
    <!-- Bata -->
    <path d="M36 282c0-76 30-104 84-110 54 6 84 34 84 110z" fill="#fff" />
    <!-- Uniforme -->
    <path d="M100 176l20 38 20-38c-8-4-32-4-40 0z" fill="var(--ill-primary)" />
    <!-- Solapas -->
    <path d="M100 176l20 38-16 50-20-72z" fill="#f2f6f7" stroke="var(--ill-soft)" stroke-width="2" stroke-linejoin="round" />
    <path d="M140 176l-20 38 16 50 20-72z" fill="#f2f6f7" stroke="var(--ill-soft)" stroke-width="2" stroke-linejoin="round" />
    <path d="M120 214v68" stroke="var(--ill-soft)" stroke-width="2" />
    <!-- Bolsillo y bolígrafo -->
    <path d="M150 230h26v18a4 4 0 0 1-4 4h-18a4 4 0 0 1-4-4z" fill="none" stroke="var(--ill-soft)" stroke-width="2" />
    <path d="M158 222v12" stroke="var(--ill-accent)" stroke-width="3.5" stroke-linecap="round" />
    <!-- Fonendoscopio -->
    <g fill="none" stroke="var(--ill-deep)" stroke-width="4" stroke-linecap="round">
      <path d="M100 178c-14 26-8 56 14 64" />
      <path d="M140 178c14 26 8 52-10 60" />
    </g>
    <circle cx="122" cy="244" r="8" fill="var(--ill-deep)" />
    <circle cx="122" cy="244" r="3.5" fill="var(--ill-soft)" />
    <path class="beat fb" d="M86 226c-3.6-2.2-5.6-4.4-5.6-6.6a2.8 2.8 0 0 1 5.6-1.2 2.8 2.8 0 0 1 5.6 1.2c0 2.2-2 4.4-5.6 6.6z" fill="var(--ill-accent)" />
  </g>

  <!-- Cabeza -->
  <circle cx="120" cy="104" r="38" fill="var(--ill-skin-2)" />
  <ellipse cx="98" cy="122" rx="7" ry="4.5" fill="var(--ill-accent)" opacity=".28" />
  <ellipse cx="142" cy="122" rx="7" ry="4.5" fill="var(--ill-accent)" opacity=".28" />
  <g class="blink fb">
    <circle cx="106" cy="108" r="3.4" fill="var(--ill-deep)" />
    <circle cx="134" cy="108" r="3.4" fill="var(--ill-deep)" />
  </g>
  <path d="M99 97q7-5 14 0M127 97q7-5 14 0" stroke="var(--ill-hair-2)" stroke-width="2.6" stroke-linecap="round" fill="none" />
  <path d="M108 124q12 10 24 0" stroke="var(--ill-deep)" stroke-width="2.8" stroke-linecap="round" fill="none" />
  <!-- Cabello (frente) -->
  <path d="M81 104c-3-34 27-46 52-38 18 6 28 22 26 38-12-12-30-24-52-22-10 1-19 9-26 22z" fill="var(--ill-hair-2)" />
  <path d="M120 70q-6 14-22 22" stroke="#fff" stroke-opacity=".18" stroke-width="3" stroke-linecap="round" fill="none" />
</svg>

<style>
  .body { transform-origin: 120px 282px; }
  @media (prefers-reduced-motion: no-preference) {
    .body { animation: ill-breathe 4.4s ease-in-out infinite; }
  }
</style>
